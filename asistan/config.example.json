{
  "assistant_name": "Jarvis",
  "wake_word": "jarvis",
  "require_wake_word": false,
  "language": "tr-TR",
  "timezone": "Europe/Istanbul",
  "openai_api_key": "",
  "openai_base_url": "https://api.openai.com/v1",
  "openai_model": "gpt-4o-mini",
  "host": "127.0.0.1",
  "port": 8787,
  "require_confirm_for_risky": true,
  "speak_responses": true,
  "window_move_timeout_sec": 60,
  "workspace_root": "~/JarvisWorkspace",
  "cursor_cli": "cursor",
  "projects": {
    "asistan": ".",
    "ortalik": "~/projects/ortalik"
  },
  "allowed_apps": {
    "notepad": "notepad.exe",
    "explorer": "explorer.exe",
    "chrome": "chrome.exe",
    "edge": "msedge.exe",
    "calculator": "calc.exe",
    "cmd": "cmd.exe",
    "spotify": "spotify.exe",
    "vscode": "code",
    "cursor": {
      "path": "cursor",
      "window_title": "Cursor",
      "process_name": "Cursor.exe"
    },
    "discord": "discord.exe",
    "steam": "steam.exe",
    "valorant": {
      "path": "C:\\Riot Games\\Riot Client\\RiotClientServices.exe",
      "args": [
        "--launch-product=valorant",
        "--launch-patchline=live"
      ],
      "window_title": "VALORANT",
      "process_name": "VALORANT-Win64-Shipping.exe"
    }
  },
  "blocked_commands": [
    "format",
    "del /s",
    "rmdir /s",
    "shutdown",
    "reg delete",
    "Remove-Item -Recurse"
  ],
  "devices": {
    "isik": {
      "name": "Oda ışığı",
      "aliases": ["ışık", "isik", "lamba", "oda ışığı"],
      "base_url": "http://192.168.1.50",
      "on_path": "/relay/on",
      "off_path": "/relay/off",
      "toggle_path": "/relay/toggle",
      "status_path": "/relay/status",
      "method": "GET",
      "token": "",
      "timeout_sec": 3.0
    }
  },
  "scenes": {
    "oyun": {
      "name": "Oyun modu",
      "aliases": ["oyun modu", "game mode", "gaming"],
      "steps": [
        {"type": "device", "target": "isik", "state": "off"},
        {"type": "open_app", "target": "valorant", "monitor": 2},
        {"type": "volume", "target": "up"}
      ]
    },
    "calisma": {
      "name": "Çalışma modu",
      "aliases": ["çalışma modu", "calisma modu", "work mode"],
      "steps": [
        {"type": "device", "target": "isik", "state": "on"},
        {"type": "open_cursor", "target": ""},
        {"type": "volume", "target": "down"}
      ]
    },
    "uyku": {
      "name": "Uyku modu",
      "aliases": ["uyku modu", "sleep"],
      "steps": [
        {"type": "device", "target": "isik", "state": "off"},
        {"type": "volume", "target": "mute"}
      ]
    }
  }
}
